# Application
# Keep false in production. DEBUG also gates the JWT-secret strength check;
# set true only for local development.
DEBUG=false
APP_NAME="Predictor v2"

# Database
DATABASE_URL=postgresql://predictor:predictor@localhost:5432/predictor

# JWT Authentication
# REQUIRED. When DEBUG=false the app refuses to start with a weak/short/default
# value. Generate a strong one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   (or: openssl rand -hex 32)
JWT_SECRET_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Football-Data.org (token for /v4 endpoints)
FOOTBALL_DATA_TOKEN=

# ─── Google Sheets sync (publish predictions + live standings) ─────
# When both are set the score scheduler mirrors the all-entries picks
# matrix and the live standings into the sheet below. Share the sheet
# VIEW-ONLY with the pool; the service account is the sole writer.
# Leave either blank → sync is a no-op (graceful degradation).
#
# GOOGLE_SHEET_ID: the id between /d/ and /edit in the sheet URL.
# GOOGLE_SERVICE_ACCOUNT_JSON: either an absolute path to the service
#   account key file, or the raw key JSON inline. Grant that account's
#   client_email Editor access to the sheet.
# SHEETS_SYNC_ENABLED: kill switch (default true) — set false to pause
#   pushes without unsetting the creds.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_SYNC_ENABLED=true

# CORS
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:3000

# Tournament config
TOURNAMENT_CONFIG_PATH=../config/worldcup2026.yml

# ─── Analytics (PostHog, EU instance) ──────────────────────────────
# Project API key (phc_*). Safe to expose in client bundles per PostHog
# docs — write-only ingestion, no read access. Get it from
# https://eu.posthog.com → Project Settings → Project API Keys.
# Backend uses POSTHOG_API_KEY for server-side capture; the frontend
# bundle reads PUBLIC_POSTHOG_KEY at BUILD time (must be set before
# `docker compose up -d --build`). Same value in both vars.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Cloudflare Web Analytics — Core Web Vitals only, no custom events.
# Beacon token from Cloudflare dashboard → Web Analytics. Leave empty
# to disable.
PUBLIC_CF_WA_TOKEN=
